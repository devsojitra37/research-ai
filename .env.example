# ===========================================
# ResearchAI — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/researchai"

# --- Authentication (Auth.js v5) ---
AUTH_SECRET="generate-a-random-secret-here"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# --- AI Provider ---
AI_PROVIDER="openai"
AI_API_KEY="your-openai-api-key"
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# --- Redis (Queue/Cache) ---
REDIS_URL="redis://localhost:6379"

# --- File Storage ---
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ResearchAI"

# --- Feature Flags ---
ENABLE_CITATION_ASSISTANT="true"
ENABLE_SIMILARITY_CHECKER="true"
ENABLE_PRESENTATION_GENERATOR="true"
ENABLE_INFOGRAPHIC_GENERATOR="true"
ENABLE_PUBLIC_PROFILES="true"
ENABLE_REFERRALS="true"
ENABLE_BLOG="true"
ENABLE_AI_DEMO_MODE="true"
